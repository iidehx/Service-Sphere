{
  "expo": {
    "name": "Service App",
    "slug": "service-app",
    "owner": "odeh20003",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/service-app-mark.png",
    "scheme": "service-app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/service-app-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FAFC"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.serviceapp.marketplace",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/service-app-mark.png",
        "backgroundColor": "#1E3A5F"
      },
    },
    "web": {
      "favicon": "./assets/images/service-app-mark.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/service-app-mark.png",
          "color": "#2563EB",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "f65f6a93-cc88-43e3-9974-9c6e31f9ce66"
      }
    }
  }
}
