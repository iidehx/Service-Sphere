# Copy this file to `.env` (same folder) and fill in the values.
# `.env` is git-ignored. Expo loads it automatically on `pnpm run dev`;
# restart the dev server after changing it.
#
# Leave the Firebase values empty to run in local demo mode.
# Firebase values: Firebase Console -> Project settings -> Your apps -> Web app config.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google sign-in (web OAuth client ID). Optional.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Local testing: set to true (e.g. in a git-ignored `.env.local`) and run
# `pnpm run emulators` to use local Firebase emulators instead of the cloud
# project. Test accounts and data then stay on this machine.
# EXPO_PUBLIC_USE_FIREBASE_EMULATOR=true
# Android emulator only: EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=10.0.2.2