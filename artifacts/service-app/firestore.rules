rules_version = '2';

// Firestore security rules for the Service App marketplace.
// Publish these in Firebase Console → Firestore Database → Rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Returns true if the authenticated user has a document in /admins.
    // Admins are added manually via Firebase Console or a trusted setup script.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Returns true if the authenticated user has NOT been disabled by an admin.
    // Disabled users have disabled:true on their /users/{uid} document.
    // A user with no profile document yet (new signup) is treated as active so
    // their initial profile creation is not blocked. We use exists() before get()
    // to avoid dereferencing .data on a missing document.
    function isActive() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || !get(/databases/$(database)/documents/users/$(request.auth.uid))
                 .data.get('disabled', false);
    }

    // Keys that any signed-in user is allowed to write to another user's doc
    // (rating aggregate mirror after a review). Everything else requires isSelf.
    function isRatingOnlyWrite() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['ratingAvg', 'ratingCount', 'recentReviews']);
    }

    // Public profile fields — safe to expose to other signed-in users.
    // Sensitive fields (email, savedJobIds, blockedUserIds, notifyQuotes,
    // verified, password) are NOT in this set.
    function publicFields() {
      return ['name', 'role', 'workArea', 'categories', 'priceRange',
              'companyInfo', 'bio', 'avatarUrl', 'ratingAvg', 'ratingCount',
              'recentReviews', 'createdAtMs'];
    }

    // ---------- Admins ----------
    // The /admins collection is read-only from clients.
    // Admins can check their own status; no client can write this collection.
    match /admins/{adminId} {
      allow read: if isSelf(adminId);
      allow write: if false;
    }

    // ---------- Users ----------
    // NOTE: Firestore rules cannot filter individual fields on reads.
    // All signed-in users can read full user documents (needed for job cards,
    // chat participant names, and public profiles). A future Cloud Function
    // can expose only public fields via an HTTP endpoint.
    match /users/{userId} {
      allow read: if signedIn();
      // Own profile create/update.
      allow create: if isSelf(userId) && isActive();
      allow update: if (isSelf(userId) && isActive())
        // Any signed-in active user may mirror rating aggregates after reviewing.
        || (signedIn() && isActive() && isRatingOnlyWrite())
        // Admins may update any user (e.g. to set disabled:true).
        || isAdmin();
      allow delete: if false;
    }

    // ---------- Jobs ----------
    match /jobs/{jobId} {
      allow read: if signedIn();

      // Employer creates their own job; must set correct employerId and open status.
      allow create: if signedIn() && isActive()
        && request.resource.data.employerId == request.auth.uid
        && request.resource.data.status == 'open';

      // Participants (employer or assigned provider) may update.
      // A provider may additionally self-assign an open, unclaimed job —
      // using hasAny(['employeeId']) safely handles missing-field case.
      allow update: if signedIn() && isActive() && (
        resource.data.employerId == request.auth.uid
        || (resource.data.get('employeeId', null) == request.auth.uid)
        || (
          // Self-assign: job is open and has no provider yet.
          resource.data.status == 'open'
          && resource.data.get('employeeId', null) == null
          && request.resource.data.get('employeeId', null) == request.auth.uid
          // Only allow the assignment fields to change, not e.g. employerId or title.
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['employeeId', 'employeeName', 'status'])
        )
      );
      allow delete: if signedIn() && isActive()
        && resource.data.employerId == request.auth.uid
        && resource.data.status == 'open';

      // Employer → provider review (one per reviewer, immutable after creation).
      match /review/{reviewerId} {
        allow read: if signedIn();
        // Reviewer must be a participant and the job must be completed.
        allow create: if isSelf(reviewerId) && isActive()
          && get(/databases/$(database)/documents/jobs/$(jobId)).data.status == 'completed'
          && (get(/databases/$(database)/documents/jobs/$(jobId)).data.employerId == request.auth.uid
              || get(/databases/$(database)/documents/jobs/$(jobId)).data.get('employeeId', null) == request.auth.uid);
        allow update, delete: if false;
      }

      // Provider → employer review (one per reviewer, immutable after creation).
      match /employerReview/{reviewerId} {
        allow read: if signedIn();
        allow create: if isSelf(reviewerId) && isActive()
          && get(/databases/$(database)/documents/jobs/$(jobId)).data.status == 'completed'
          && (get(/databases/$(database)/documents/jobs/$(jobId)).data.employerId == request.auth.uid
              || get(/databases/$(database)/documents/jobs/$(jobId)).data.get('employeeId', null) == request.auth.uid);
        allow update, delete: if false;
      }
    }

    // ---------- Chats ----------

    // Resolves the other participant in a 2-person chat given the caller's uid.
    function otherParticipant(participants) {
      return participants[0] == request.auth.uid
        ? participants[1]
        : participants[0];
    }

    match /chats/{chatId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participants;

      allow create: if signedIn() && isActive()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        // No self-chat.
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && (
          // --- Job-linked chat: any participant initiates (provider accepts a job). ---
          (request.resource.data.jobId != ''
            // Verify the job exists and the caller is a participant.
            && get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.employerId
                in request.resource.data.participants)
          ||
          // --- Direct chat: employer contacts a provider (no job attached). ---
          (request.resource.data.jobId == ''
            // Caller must be an employer.
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'employer'
            // The other participant must be a provider.
            && get(/databases/$(database)/documents/users/$(
                otherParticipant(request.resource.data.participants)
               )).data.role == 'provider'
          )
        );

      // Participants may update chat metadata (lastMessage, lastReadAt, etc.)
      // but cannot alter the participant list itself.
      allow update: if signedIn() && isActive()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        // Message sender must be the authenticated active user.
        allow create: if signedIn() && isActive()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ---------- Notifications ----------
    // Owner reads/updates/deletes their own.
    // Any signed-in active user may create a notification, but the `userId` field must be
    // set to a real user other than themselves (prevents self-spam rings).
    match /notifications/{notificationId} {
      allow read, update, delete: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && isActive()
        && request.resource.data.keys().hasAll(['userId', 'kind', 'title', 'body', 'read', 'createdAtMs'])
        && request.resource.data.userId != request.auth.uid;
    }

    // ---------- Reports ----------
    // Write-only for regular users; admins can read and review (dismiss) reports.
    match /reports/{reportId} {
      allow create: if signedIn() && isActive()
        && request.resource.data.reporterId == request.auth.uid;
      // Admins can read all reports and mark them as reviewed/dismissed.
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }
  }
}
