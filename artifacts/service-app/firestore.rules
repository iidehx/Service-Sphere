rules_version = '2';

// Firestore security rules for the Service App marketplace.
// Publish these in Firebase Console → Firestore Database → Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function profilePath(userId) {
      return /databases/$(database)/documents/publicProfiles/$(userId);
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isActive() {
      return signedIn()
        && (!exists(userPath(request.auth.uid))
          || !get(userPath(request.auth.uid)).data.get('disabled', false));
    }

    function isEmployer() {
      return signedIn()
        && get(userPath(request.auth.uid)).data.role == 'employer';
    }

    function isProvider() {
      return signedIn()
        && get(userPath(request.auth.uid)).data.role == 'provider';
    }

    function currentUserName() {
      return get(userPath(request.auth.uid)).data.name;
    }

    function validRole(role) {
      return role == 'employer' || role == 'provider';
    }

    function validUserDocument(data) {
      return data.keys().hasAll([
          'name', 'email', 'role', 'workArea', 'categories', 'priceRange',
          'companyInfo', 'bio', 'avatarUrl', 'ratingAvg', 'ratingCount',
          'recentReviews', 'savedJobIds', 'savedProviderIds', 'blockedUserIds',
          'notifyQuotes', 'verified', 'availableForWork', 'createdAtMs'
        ])
        && data.keys().hasOnly([
          'name', 'email', 'role', 'workArea', 'categories', 'priceRange',
          'companyInfo', 'bio', 'avatarUrl', 'ratingAvg', 'ratingCount',
          'recentReviews', 'savedJobIds', 'savedProviderIds', 'blockedUserIds',
          'notifyQuotes', 'verified', 'availableForWork', 'createdAtMs',
          'disabled'
        ])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
        && data.email is string && data.email.size() <= 320
        && validRole(data.role)
        && data.workArea is string && data.workArea.size() <= 160
        && data.categories is list && data.categories.size() <= 12
        && data.priceRange is string && data.priceRange.size() <= 120
        && data.companyInfo is string && data.companyInfo.size() <= 1000
        && data.bio is string && data.bio.size() <= 2000
        && data.avatarUrl is string && data.avatarUrl.size() <= 2000
        && data.ratingAvg is number && data.ratingAvg >= 0 && data.ratingAvg <= 5
        && data.ratingCount is int && data.ratingCount >= 0
        && data.recentReviews is list && data.recentReviews.size() <= 5
        && data.savedJobIds is list && data.savedJobIds.size() <= 500
        && data.savedProviderIds is list && data.savedProviderIds.size() <= 500
        && data.blockedUserIds is list && data.blockedUserIds.size() <= 500
        && data.notifyQuotes is bool && data.verified is bool
        && data.availableForWork is bool && data.createdAtMs is number;
    }

    function validPublicProfile(data) {
      return data.keys().hasAll([
          'name', 'role', 'workArea', 'categories', 'priceRange', 'companyInfo',
          'bio', 'avatarUrl', 'ratingAvg', 'ratingCount', 'recentReviews',
          'verified', 'availableForWork', 'createdAtMs'
        ])
        && data.keys().hasOnly([
          'name', 'role', 'workArea', 'categories', 'priceRange', 'companyInfo',
          'bio', 'avatarUrl', 'ratingAvg', 'ratingCount', 'recentReviews',
          'verified', 'availableForWork', 'createdAtMs'
        ])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
        && validRole(data.role)
        && data.workArea is string && data.workArea.size() <= 160
        && data.categories is list && data.categories.size() <= 12
        && data.priceRange is string && data.priceRange.size() <= 120
        && data.companyInfo is string && data.companyInfo.size() <= 1000
        && data.bio is string && data.bio.size() <= 2000
        && data.avatarUrl is string && data.avatarUrl.size() <= 2000
        && data.ratingAvg is number && data.ratingAvg >= 0 && data.ratingAvg <= 5
        && data.ratingCount is int && data.ratingCount >= 0
        && data.recentReviews is list && data.recentReviews.size() <= 5
        && data.verified is bool && data.availableForWork is bool
        && data.createdAtMs is number;
    }

    function hasEmptyRatingSummary(data) {
      return data.ratingAvg == 0
        && data.ratingCount == 0
        && data.recentReviews.size() == 0;
    }

    function publicProfileMatchesPrivate(userId) {
      let privateProfile = getAfter(userPath(userId)).data;
      return request.resource.data.name == privateProfile.name
        && request.resource.data.role == privateProfile.role
        && request.resource.data.workArea == privateProfile.workArea
        && request.resource.data.categories == privateProfile.categories
        && request.resource.data.priceRange == privateProfile.priceRange
        && request.resource.data.companyInfo == privateProfile.companyInfo
        && request.resource.data.bio == privateProfile.bio
        && request.resource.data.avatarUrl == privateProfile.avatarUrl
        && request.resource.data.ratingAvg == privateProfile.ratingAvg
        && request.resource.data.ratingCount == privateProfile.ratingCount
        && request.resource.data.recentReviews == privateProfile.recentReviews
        && request.resource.data.verified == privateProfile.verified
        && request.resource.data.availableForWork == privateProfile.availableForWork
        && request.resource.data.createdAtMs == privateProfile.createdAtMs;
    }

    // Rating summaries are maintained by the trusted Firebase Functions trigger
    // after an immutable review is created. Mobile clients cannot edit them.
    function selfEditableUserFields() {
      return [
        'name', 'workArea', 'categories', 'priceRange', 'companyInfo', 'bio',
        'avatarUrl', 'savedJobIds', 'savedProviderIds', 'blockedUserIds',
        'notifyQuotes', 'availableForWork'
      ];
    }

    function publicEditableFields() {
      return [
        'name', 'workArea', 'categories', 'priceRange', 'companyInfo', 'bio',
        'avatarUrl', 'availableForWork'
      ];
    }

    // Private account data (email, saved items, blocked users, notification
    // preferences) is visible only to its owner. Public fields live separately
    // in /publicProfiles so provider search never exposes private data.
    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create: if isSelf(userId) && isActive()
        && validUserDocument(request.resource.data)
        && hasEmptyRatingSummary(request.resource.data)
        && request.resource.data.verified == false
        && !request.resource.data.keys().hasAny(['disabled']);
      allow update: if (isSelf(userId) && isActive()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(selfEditableUserFields()))
        || isAdmin();
      allow delete: if false;
    }

    match /publicProfiles/{userId} {
      allow read: if signedIn();
      allow create: if isSelf(userId) && isActive()
        && validPublicProfile(request.resource.data)
        && hasEmptyRatingSummary(request.resource.data)
        && publicProfileMatchesPrivate(userId);
      allow update: if (isSelf(userId) && isActive()
          && validPublicProfile(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(publicEditableFields())
          && publicProfileMatchesPrivate(userId))
        || isAdmin();
      allow delete: if false;
    }

    match /admins/{adminId} {
      allow read: if isSelf(adminId);
      allow write: if false;
    }

    function isJobEmployer() {
      return resource.data.employerId == request.auth.uid;
    }

    function isJobProvider() {
      return resource.data.get('employeeId', null) == request.auth.uid;
    }

    function isJobParticipant() {
      return isJobEmployer() || isJobProvider();
    }

    function validJobCreate() {
      return request.resource.data.keys().hasAll([
          'title', 'category', 'details', 'priceOffer', 'scheduledAt',
          'leaveTimeToEmployee', 'employerId', 'employerName', 'status',
          'paymentStatus', 'employerQuoteAccepted', 'employeeQuoteAccepted',
          'reviewedBy', 'createdAtMs'
        ])
        && request.resource.data.keys().hasOnly([
          'title', 'category', 'details', 'priceOffer', 'scheduledAt',
          'leaveTimeToEmployee', 'employerId', 'employerName', 'status',
          'paymentStatus', 'employerQuoteAccepted', 'employeeQuoteAccepted',
          'reviewedBy', 'createdAtMs'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 160
        && request.resource.data.category is string && request.resource.data.category.size() <= 80
        && request.resource.data.details is string
        && request.resource.data.details.size() >= 10 && request.resource.data.details.size() <= 5000
        && request.resource.data.priceOffer is number && request.resource.data.priceOffer > 0
        && validScheduleValue(request.resource.data.scheduledAt, request.resource.data.leaveTimeToEmployee)
        && request.resource.data.leaveTimeToEmployee is bool
        && request.resource.data.employerId == request.auth.uid
        && request.resource.data.employerName == currentUserName()
        && request.resource.data.status == 'open'
        && request.resource.data.paymentStatus == 'pending'
        && request.resource.data.employerQuoteAccepted == false
        && request.resource.data.employeeQuoteAccepted == false
        && request.resource.data.reviewedBy is list && request.resource.data.reviewedBy.size() == 0
        && request.resource.data.createdAtMs is number;
    }

    function validScheduleValue(value, flexible) {
      // New app versions save an ISO timestamp. Existing production builds
      // used a short human-readable value, so keep that legacy form valid
      // while the app update rolls out.
      return value is string && value.size() >= 3 && value.size() <= 120;
    }

    function isProviderClaim() {
      return isProvider()
        && resource.data.status == 'open'
        && resource.data.get('employeeId', null) == null
        && request.resource.data.get('employeeId', null) == request.auth.uid
        && request.resource.data.get('employeeName', '') == currentUserName()
        && request.resource.data.status == 'negotiating'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['employeeId', 'employeeName', 'status']);
    }

    function isEmployerJobEdit() {
      return isJobEmployer()
        && resource.data.status == 'open'
        && request.resource.data.status == 'open'
        && validScheduleValue(request.resource.data.scheduledAt, request.resource.data.leaveTimeToEmployee)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['title', 'category', 'details', 'priceOffer', 'scheduledAt', 'leaveTimeToEmployee']);
    }

    function validQuoteProposal() {
      return isJobParticipant()
        && resource.data.status != 'accepted' && resource.data.status != 'completed'
        && request.resource.data.status == 'negotiating'
        && request.resource.data.quoteBy == request.auth.uid
        && request.resource.data.proposedPrice is number && request.resource.data.proposedPrice > 0
        && request.resource.data.quoteBreakdown is map
        && request.resource.data.employerQuoteAccepted == false
        && request.resource.data.employeeQuoteAccepted == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'proposedPrice', 'quoteBreakdown', 'quoteBy',
          'employerQuoteAccepted', 'employeeQuoteAccepted', 'agreedPrice', 'platformFee'
        ]);
    }

    function validQuoteAcceptance() {
      return isJobParticipant()
        && resource.data.status == 'negotiating'
        && resource.data.get('proposedPrice', null) is number
        && request.resource.data.proposedPrice == resource.data.proposedPrice
        && request.resource.data.quoteBy == resource.data.quoteBy
        && ((isJobEmployer() && resource.data.employerQuoteAccepted == false
              && request.resource.data.employerQuoteAccepted == true
              && request.resource.data.employeeQuoteAccepted == resource.data.employeeQuoteAccepted)
          || (isJobProvider() && resource.data.employeeQuoteAccepted == false
              && request.resource.data.employeeQuoteAccepted == true
              && request.resource.data.employerQuoteAccepted == resource.data.employerQuoteAccepted))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'employerQuoteAccepted', 'employeeQuoteAccepted', 'status', 'agreedPrice', 'platformFee'
        ])
        && (
          (request.resource.data.employerQuoteAccepted == true
            && request.resource.data.employeeQuoteAccepted == true
            && request.resource.data.status == 'accepted'
            && request.resource.data.agreedPrice == request.resource.data.proposedPrice
            && request.resource.data.platformFee is number)
          || (
            !(request.resource.data.employerQuoteAccepted == true
              && request.resource.data.employeeQuoteAccepted == true)
            && request.resource.data.status == 'negotiating'
            && !request.resource.data.keys().hasAny(['agreedPrice', 'platformFee'])
          )
        );
    }

    function validQuoteDecline() {
      return isJobParticipant()
        && resource.data.status == 'negotiating'
        && request.resource.data.status == 'negotiating'
        && request.resource.data.employerQuoteAccepted == false
        && request.resource.data.employeeQuoteAccepted == false
        && !request.resource.data.keys().hasAny(['proposedPrice', 'quoteBreakdown', 'quoteBy'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'proposedPrice', 'quoteBreakdown', 'quoteBy',
          'employerQuoteAccepted', 'employeeQuoteAccepted'
        ]);
    }

    function validPaymentUpdate() {
      return isJobEmployer()
        && (resource.data.status == 'accepted' || resource.data.status == 'completed')
        && request.resource.data.paymentStatus in ['paid', 'refunded']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentStatus']);
    }

    function validCompletion() {
      return isJobEmployer()
        && resource.data.status == 'accepted'
        && request.resource.data.status == 'completed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }

    function validReviewMarker(jobId) {
      return isJobParticipant()
        && resource.data.status == 'completed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewedBy'])
        && request.resource.data.reviewedBy.size() == resource.data.reviewedBy.size() + 1
        && request.resource.data.reviewedBy.hasAll(resource.data.reviewedBy)
        && !resource.data.reviewedBy.hasAny([request.auth.uid])
        && request.resource.data.reviewedBy.hasAll([request.auth.uid])
        && (
          (isJobEmployer()
            && getAfter(/databases/$(database)/documents/jobs/$(jobId)/review/$(request.auth.uid)).data.reviewerId == request.auth.uid)
          || (isJobProvider()
            && getAfter(/databases/$(database)/documents/jobs/$(jobId)/employerReview/$(request.auth.uid)).data.reviewerId == request.auth.uid)
        );
    }

    function validReview(data, targetUserId) {
      return data.keys().hasAll([
          'jobId', 'jobTitle', 'reviewerId', 'reviewerName', 'targetUserId',
          'rating', 'tags', 'comment', 'createdAtMs'
        ])
        && data.keys().hasOnly([
          'jobId', 'jobTitle', 'reviewerId', 'reviewerName', 'targetUserId',
          'rating', 'communication', 'quality', 'punctuality', 'tags',
          'comment', 'createdAtMs'
        ])
        && data.jobId is string && data.jobTitle is string && data.jobTitle.size() <= 160
        && data.reviewerId == request.auth.uid && data.reviewerName == currentUserName()
        && data.targetUserId == targetUserId
        && data.rating is int && data.rating >= 1 && data.rating <= 5
        && (!data.keys().hasAny(['communication'])
          || (data.communication is int && data.communication >= 1 && data.communication <= 5))
        && (!data.keys().hasAny(['quality'])
          || (data.quality is int && data.quality >= 1 && data.quality <= 5))
        && (!data.keys().hasAny(['punctuality'])
          || (data.punctuality is int && data.punctuality >= 1 && data.punctuality <= 5))
        && data.tags is list && data.tags.size() <= 8
        && data.tags.hasOnly([
          'Professional', 'On time', 'Great value', 'Friendly', 'Clean work',
          'Clear communication', 'Would hire again', 'Went above & beyond'
        ])
        && data.comment is string && data.comment.size() <= 2000
        && data.createdAtMs is number;
    }

    match /jobs/{jobId} {
      // The marketplace feed intentionally exposes job details to signed-in
      // providers. It does not include private contact or account fields.
      allow read: if signedIn();
      allow create: if isActive() && isEmployer() && validJobCreate();
      allow update: if isActive() && (
        isProviderClaim()
        || isEmployerJobEdit()
        || validQuoteProposal()
        || validQuoteAcceptance()
        || validQuoteDecline()
        || validPaymentUpdate()
        || validCompletion()
        || validReviewMarker(jobId)
      );
      allow delete: if isActive() && isJobEmployer() && resource.data.status == 'open';

      match /review/{reviewerId} {
        allow read: if signedIn();
        allow create: if isSelf(reviewerId) && isActive()
          && get(/databases/$(database)/documents/jobs/$(jobId)).data.status == 'completed'
          && get(/databases/$(database)/documents/jobs/$(jobId)).data.employerId == request.auth.uid
          && validReview(
            request.resource.data,
            get(/databases/$(database)/documents/jobs/$(jobId)).data.get('employeeId', '')
          );
        allow update, delete: if false;
      }

      match /employerReview/{reviewerId} {
        allow read: if signedIn();
        allow create: if isSelf(reviewerId) && isActive()
          && get(/databases/$(database)/documents/jobs/$(jobId)).data.status == 'completed'
          && get(/databases/$(database)/documents/jobs/$(jobId)).data.get('employeeId', '') == request.auth.uid
          && validReview(
            request.resource.data,
            get(/databases/$(database)/documents/jobs/$(jobId)).data.employerId
          );
        allow update, delete: if false;
      }
    }

    function otherParticipant(participants) {
      return participants[0] == request.auth.uid ? participants[1] : participants[0];
    }

    function validChatDocument() {
      return request.resource.data.keys().hasAll([
          'jobId', 'jobTitle', 'participants', 'participantNames', 'lastMessage',
          'lastMessageAtMs', 'lastReadAt', 'createdAtMs'
        ])
        && request.resource.data.keys().hasOnly([
          'jobId', 'jobTitle', 'participants', 'participantNames', 'lastMessage',
          'lastMessageAtMs', 'lastSenderId', 'lastReadAt', 'createdAtMs'
        ])
        && request.resource.data.jobId is string && request.resource.data.jobTitle is string
        && request.resource.data.participants is list && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participantNames is map
        && request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 2000
        && request.resource.data.lastMessageAtMs is number
        && request.resource.data.lastReadAt is map && request.resource.data.createdAtMs is number;
    }

    function validJobChatCreate() {
      let job = get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data;
      return request.resource.data.jobId != ''
        && job.employerId in request.resource.data.participants
        && (
          job.get('employeeId', null) == request.auth.uid
          || (job.status == 'open' && job.get('employeeId', null) == null && isProvider())
        );
    }

    function validDirectChatCreate() {
      return request.resource.data.jobId == ''
        && isEmployer()
        && get(profilePath(otherParticipant(request.resource.data.participants))).data.role == 'provider';
    }

    function validChatMetadataUpdate() {
      return request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastMessage', 'lastMessageAtMs', 'lastSenderId', 'lastReadAt'])
        && request.resource.data.lastReadAt.diff(resource.data.lastReadAt).affectedKeys()
             .hasOnly([request.auth.uid])
        && (
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['lastMessage', 'lastMessageAtMs', 'lastSenderId'])
          || (request.resource.data.lastSenderId == request.auth.uid
            && request.resource.data.lastMessage is string
            && request.resource.data.lastMessage.size() <= 2000
            && request.resource.data.lastMessageAtMs is number)
        );
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if isActive() && validChatDocument()
        && (validJobChatCreate() || validDirectChatCreate());
      allow update: if isActive() && request.auth.uid in resource.data.participants
        && validChatMetadataUpdate();
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isActive()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.keys().hasOnly(['senderId', 'senderName', 'text', 'kind', 'createdAtMs'])
          && request.resource.data.keys().hasAll(['senderId', 'senderName', 'text', 'kind', 'createdAtMs'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName == currentUserName()
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && request.resource.data.kind in ['text', 'quote', 'system']
          && request.resource.data.createdAtMs is number;
        allow update, delete: if false;
      }
    }

    function validNotification() {
      let job = get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data;
      return request.resource.data.keys().hasAll(['userId', 'kind', 'title', 'body', 'jobId', 'read', 'createdAtMs'])
        && request.resource.data.keys().hasOnly(['userId', 'kind', 'title', 'body', 'jobId', 'chatId', 'read', 'createdAtMs'])
        && request.resource.data.userId is string && request.resource.data.userId != request.auth.uid
        && request.resource.data.kind in ['job', 'quote', 'payment', 'review', 'message', 'system']
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 160
        && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 2000
        && request.resource.data.jobId is string && request.resource.data.jobId != ''
        && request.resource.data.read == false && request.resource.data.createdAtMs is number
        && (job.employerId == request.auth.uid || job.get('employeeId', null) == request.auth.uid)
        && (job.employerId == request.resource.data.userId || job.get('employeeId', null) == request.resource.data.userId);
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if isActive() && validNotification();
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /reports/{reportId} {
      allow create: if isActive()
        && request.resource.data.keys().hasAll(['reporterId', 'reportedUserId', 'reason', 'message', 'createdAtMs'])
        && request.resource.data.keys().hasOnly(['reporterId', 'reportedUserId', 'jobId', 'reason', 'message', 'createdAtMs'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedUserId is string
        && request.resource.data.reportedUserId != request.auth.uid
        && request.resource.data.reason is string && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 120
        && request.resource.data.message is string && request.resource.data.message.size() <= 2000
        && request.resource.data.createdAtMs is number;
      allow read, update: if isAdmin();
      allow delete: if false;
    }
  }
}