rules_version = '2';

// Firebase Cloud Storage security rules for profile avatars.
// Publish these in Firebase Console → Storage → Rules.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function ownsAvatar(fileName) {
      return signedIn()
        && fileName.matches(
          '^' + request.auth.uid + '-[0-9]{10,20}[.]jpg$'
        );
    }

    match /avatars/{fileName} {
      // Avatar URLs are shown to signed-in marketplace users.
      allow read: if signedIn();

      // The app writes avatars/{uid}-{timestamp}.jpg.
      allow create, update: if ownsAvatar(fileName)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');

      allow delete: if ownsAvatar(fileName);
    }

    function ownsJobPhoto(fileName) {
      return signedIn()
        && fileName.matches(
          '^' + request.auth.uid + '-[0-9]{10,20}-[0-9]{1,3}[.]jpg$'
        );
    }

    // Before/after job photos. Whether a given URL actually gets linked
    // into a job (and thus becomes visible to anyone) is governed entirely
    // by firestore.rules on jobs/{jobId}/private/photos — this Storage path
    // only needs to stop strangers from writing into someone else's upload
    // slot or reading arbitrary bytes. Reads stay signed-in-only, matching
    // the same obscurity model already used for avatars: the app never
    // reveals a photo's URL to a client the Firestore rules wouldn't have
    // already let read that document.
    match /jobPhotos/{jobId}/{kind}/{fileName} {
      allow read: if signedIn();

      // The app writes jobPhotos/{jobId}/before|after/{uid}-{timestamp}-{index}.jpg.
      allow create, update: if (kind == 'before' || kind == 'after')
        && ownsJobPhoto(fileName)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');

      allow delete: if ownsJobPhoto(fileName);
    }

    // Deny every other Storage path by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}